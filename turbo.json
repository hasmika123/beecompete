{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // The admin app ships a generated copy of the paste-JSON prompt and a test that compares it to
  // the doc — so an edit to that doc has to invalidate task caches it otherwise sits outside of.
  "globalDependencies": ["docs/seeding/paste-json-prompt.md"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NEXT_PUBLIC_* is baked into the client bundle — declaring it keys the Turbo cache
      // so a build with a different DSN/release is never served from a stale cache entry.
      "env": ["NEXT_PUBLIC_SENTRY_DSN", "NEXT_PUBLIC_SENTRY_RELEASE"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
